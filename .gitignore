# Secrets
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs / runtime (contents ignored; .gitkeep preserves structure)
logs/*
!logs/.gitkeep
reports/runtime/
*.log

# Data (contents ignored; .gitkeep preserves structure)
data/raw/*
data/processed/*
data/cache/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep

# Broker/account sensitive dumps
broker_state_*.json
account_info_*.json
trade_dump_*.json

# Editor / OS
.vscode/settings.json
.DS_Store


# Kill switch / runtime control state
control/
